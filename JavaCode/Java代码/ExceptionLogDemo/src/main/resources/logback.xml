<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!-- 1. 控制台输出 Appender：日志打印到控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 日志格式：时间 | 级别 | 类名 | 日志消息 | 换行 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %-5level | %logger{36} | %msg%n</pattern>
            <charset>UTF-8</charset> <!-- 防止中文乱码 -->
        </encoder>
    </appender>

    <!-- 2. 文件输出 Appender：日志写入文件，按天滚动 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件保存路径 -->
        <file>logs/app.log</file>
        <!-- 滚动策略：按天生成日志文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 文件名格式：app.2026-01-22.log -->
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 日志保留天数：7天 -->
            <maxHistory>7</maxHistory>
            <!-- 单个日志文件最大大小：10MB -->
            <totalSizeCap>10MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %-5level | %logger{36} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 3. 根日志配置 -->
    <root level="INFO">
        <!-- 同时输出到控制台和文件 -->
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 4. 单独配置我们的主类日志级别（覆盖根级别） -->
    <!-- 这里的 name 是主类的完整包名+类名 -->
    <logger name="com.example.ExceptionAssertLogExperience" level="DEBUG"/>
</configuration>